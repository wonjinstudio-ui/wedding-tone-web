# /etc/wsnap/wsnap.env — 서버 설정(server-setup.sh가 처음 한 번 이 견본으로 만듦). 비밀 값이 있으니 다른 곳에 올리지 마세요.
# 바꾼 뒤: sudo systemctl restart wsnap-api wsnap-engine wsnap-worker wsnap-web

# ---- 주소 ----
DOMAIN=__DOMAIN__
WEB_ORIGIN=https://__DOMAIN__
PUBLIC_URL=https://__DOMAIN__

# ---- 실행 ----
NODE_ENV=production
HOST=127.0.0.1
PORT=8781
TRUST_PROXY=1
DATA_DIR=/srv/wsnap/data
ENGINE_URL=http://127.0.0.1:8790
ENGINE_API_KEY=__ENGINE_KEY__
# 엔진 API가 메모리에 들고 있는 사진 수(1장 약 20MB). 8GB 서버는 40이면 넉넉함
WSNAP_MEM_MAX=40
WSNAP_TONE_SRC=jpg

# ---- 서비스 규칙 ----
# 시험 운영(무료): 작가마다 무료 결혼식을 넉넉히. 유료로 바꿀 때 1로 내리고 결제를 붙임
FREE_WEDDINGS=100
DEV_PAYMENTS=0
RETENTION_DAYS=14
MAX_PHOTOS=2500
TERMS_VERSION=2026-11-trial

# ---- 나중에(지금은 비워 둠) ----
# 저장소: 시험 운영은 서버 디스크(/srv/wsnap/data/storage). R2로 옮길 때 아래를 채우고 README의 'R2로 옮기기'를 따름
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# 구글·카카오 로그인
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
