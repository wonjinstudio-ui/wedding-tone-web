[Unit]
Description=웨딩 톤 워커 (분석·옮기기·내보내기·삭제)
After=network.target

[Service]
User=wsnap
WorkingDirectory=/srv/wsnap/app/engine
EnvironmentFile=/etc/wsnap/wsnap.env
ExecStart=/srv/wsnap/venv/bin/python -m wsnap.worker run --queue /srv/wsnap/data/jobs.sqlite --storage /srv/wsnap/data/storage --work-root /srv/wsnap/data/work
Restart=always
RestartSec=5
# 멈추라는 신호를 받으면 하던 작업을 끝내고 멈춤(내보내기 최대 약 20분)
KillSignal=SIGTERM
TimeoutStopSec=1500
# 미리보기(엔진 API)가 워커보다 먼저 CPU를 받도록
Nice=5

[Install]
WantedBy=multi-user.target
